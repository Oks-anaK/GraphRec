# Django настройки
SECRET_KEY=my_secret_key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — если задано DB_NAME, Django подключается к PostgreSQL (драйвер psycopg в зависимостях).
# Без DB_NAME используется SQLite (db.sqlite3) для локальной разработки.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis — кэш Django (локально: redis://127.0.0.1:6379/1; на сервере — URL вашего инстанса)
LOCATION=my_location